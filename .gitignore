# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Verification corpus — downloaded images and derived fixtures
# Both are regenerable: images via build_fixtures.py, fixtures via build_fixtures.py
verification/images/*
!verification/images/README.md
verification/fixtures/*
!verification/fixtures/.gitkeep

# Test fixtures — generated by test_image_preprocessing.py on demand
tests/fixtures/*
!tests/fixtures/.gitkeep

# Model weights — NEVER commit
weights/*
!weights/.gitkeep

# Exported .aimodel files — upload to HuggingFace instead
exports/*
!exports/.gitkeep
*.aimodel

# macOS / Xcode
.DS_Store
DerivedData/
*.xcworkspace/
