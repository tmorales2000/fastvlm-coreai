# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# test_assets — downloaded images are large and regenerable, exclude them
test_assets/images/*
!test_assets/images/README.md

# Fixtures — derived from weights + corpus images, regenerate with build_fixtures.py
test_assets/fixtures/*
!test_assets/fixtures/.gitkeep

# Model weights — NEVER commit
weights/*
!weights/.gitkeep

# Exported .aimodel files — upload to HuggingFace instead
exports/*
!exports/.gitkeep
*.aimodel

# macOS / Xcode
.DS_Store
DerivedData/
*.xcworkspace/
